# =============================================================================
# AI-Powered PR Reviewer — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# ---- GitHub (READ-ONLY fine-grained PAT) ----
# Create a fine-grained PAT on a dedicated bot account with ONLY:
#   Repository permissions -> Contents: Read-only
#   Repository permissions -> Pull requests: Read-only
#   Repository permissions -> Metadata: Read-only
# No write scopes. The system never writes to GitHub.
GITHUB_TOKEN=github_pat_xxx
GITHUB_API_BASE=https://api.github.com

# ---- LLM: Google Gemini ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Judgment-heavy review pass:
GEMINI_MODEL=gemini-2.5-pro
# Cheaper second-pass semantic verification:
GEMINI_VERIFY_MODEL=gemini-2.5-flash

# ---- Embeddings: local sentence-transformers (no API key) ----
# all-MiniLM-L6-v2 -> 384 dims. If you change the model, update EMBEDDING_DIM
# AND the value in the Alembic migration (vector column is fixed-width).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Database ----
# Inside docker-compose this host is "db"; from your host it's "localhost".
DATABASE_URL=postgresql+psycopg2://prr:prr@db:5432/prr

# ---- RAG / pipeline knobs ----
RETRIEVAL_TOP_K=8
# Findings below this confidence are dropped after verification.
CONFIDENCE_THRESHOLD=0.55

# ---- App ----
LOG_LEVEL=INFO
# Comma-separated origins for the dashboard (Vite dev server default shown).
CORS_ORIGINS=http://localhost:5173
